local ghostTween = nil

local function setGhostTransparency(target, duration)
	if ghostTween then ghostTween:Cancel() end
	ghostTween = TweenService:Create(ghostLabel, TweenInfo.new(duration, Enum.EasingStyle.Quint), {TextTransparency = target})
	ghostTween:Play()
end

local function updateGhost(text)
	local cmdPart = text:match("^(%S+)") or ""
	if text == "" or text:find(" ") then
		setGhostTransparency(1, 0.15)
		return
	end
	local _, matchAlias = getBestMatch(text)
	if matchAlias then
		local suffix = matchAlias:sub(#cmdPart + 1)
		local typedWidth = TextService:GetTextSize(text, 15, Enum.Font.GothamBold, Vector2.new(9999, 9999)).X
		ghostLabel.Text = suffix
		ghostLabel.Position = UDim2.fromOffset(36 + typedWidth, 0)
		ghostLabel.Size = UDim2.new(1, -(36 + typedWidth), 1, 0)
		setGhostTransparency(0.55, 0.12)
	else
		setGhostTransparency(1, 0.12)
	end
end

