----------------------------------------------------------------------
-- destroy any previous copy (re-execute safe)
----------------------------------------------------------------------
if env.__FCB_NOTCH_DESTROY then
	pcall(env.__FCB_NOTCH_DESTROY)
	env.__FCB_NOTCH_DESTROY = nil
end
do
	local roots = {}
	pcall(function()
		table.insert(roots, CoreGui)
	end)
	pcall(function()
		if gethui then
			table.insert(roots, gethui())
		end
	end)
	pcall(function()
		table.insert(roots, player:FindFirstChildOfClass("PlayerGui"))
	end)
	for _, root in ipairs(roots) do
		pcall(function()
			for _, child in ipairs(root:GetChildren()) do
				if child.Name == "FCB_Notch" then
					child:Destroy()
				end
			end
		end)
	end
end

