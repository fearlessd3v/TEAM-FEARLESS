local registeredCmds = {}
local CommandSystem = {}

function CommandSystem:AddCmd(data)
	table.insert(registeredCmds, {
		title = data.Title,
		alias = data.Alias or {data.Title},
		args = data.Args or false,
		variables = data.Variables or {},
		callback = data.Callback,
	})
end

local function getBestMatch(input)
	if input == "" then return nil, nil end
	local lower = input:lower()
	local cmdPart = lower:match("^(%S+)") or lower
	for _, cmd in ipairs(registeredCmds) do
		for _, alias in ipairs(cmd.alias) do
			local al = alias:lower()
			if al:sub(1, #cmdPart) == cmdPart and al ~= cmdPart then
				return cmd, al
			end
		end
	end
	return nil, nil
end

local function parseAndRun(input)
	input = input:match("^%s*(.-)%s*$")
	if input == "" then return end
	local parts = {}
	for part in input:gmatch("%S+") do table.insert(parts, part) end
	local cmdName = parts[1]:lower()
	for _, cmd in ipairs(registeredCmds) do
		for _, alias in ipairs(cmd.alias) do
			if alias:lower() == cmdName then
				if cmd.args then
					local args = {}
					for i = 2, #parts do table.insert(args, parts[i]) end
					task.spawn(cmd.callback, table.unpack(args))
				else
					task.spawn(cmd.callback)
				end
				return
			end
		end
	end
end

local function parseAndRunBestMatch(input)
	input = input:match("^%s*(.-)%s*$")
	if input == "" then return end
	local parts = {}
	for part in input:gmatch("%S+") do table.insert(parts, part) end
	local cmdPart = parts[1]:lower()
	local matchedCmd = nil
	for _, cmd in ipairs(registeredCmds) do
		for _, alias in ipairs(cmd.alias) do
			if alias:lower():sub(1, #cmdPart) == cmdPart then
				matchedCmd = cmd
				break
			end
		end
		if matchedCmd then break end
	end
	if matchedCmd then
		if matchedCmd.args then
			local args = {}
			for i = 2, #parts do table.insert(args, parts[i]) end
			task.spawn(matchedCmd.callback, table.unpack(args))
		else
			task.spawn(matchedCmd.callback)
		end
	end
end


