local function SetupPlayerTag(player, rank)
	local isLocalPlayer = player == Players.LocalPlayer

	local function onCharacterAdded(character)
		task.wait(0.5)
		if scriptusers[player.Name] then
			CreatePremiumTag(character, rank, player.Name, isLocalPlayer)
		end
	end

	if player.Character then
		onCharacterAdded(player.Character)
	end

	player.CharacterAdded:Connect(onCharacterAdded)
end

local function register(plr)
	if not scriptusers[plr.Name] then
		scriptusers[plr.Name] = true
		if plr.Character then
			local rank = _G.FCB_USERS and _G.FCB_USERS[plr.UserId] or "USER"
			CreatePremiumTag(plr.Character, rank, plr.Name, plr == Players.LocalPlayer)
		end
	end
end

