local fps = 60
local fpsFrames, fpsTime = 0, 0

local function getPing()
	local ok, v = pcall(function()
		return Stats.Network.ServerStatsItem["Data Ping"]:GetValue()
	end)
	if ok and type(v) == "number" then
		return math.floor(v + 0.5)
	end
	return nil
end

local function updateStats()
	vPlayers.Text = #Players:GetPlayers() .. "/" .. Players.MaxPlayers
	vFps.Text = tostring(math.floor(fps + 0.5))
	if fps >= 50 then
		vFps.TextColor3 = Color3.fromRGB(110, 230, 140)
	elseif fps >= 30 then
		vFps.TextColor3 = Color3.fromRGB(255, 200, 90)
	else
		vFps.TextColor3 = Color3.fromRGB(255, 100, 100)
	end
	local ping = getPing()
	vPing.Text = ping and (ping .. " ms") or "-"
	vTime.Text = os.date("%H:%M:%S")
	vDate.Text = os.date("%d %b %Y")
	vDay.Text = os.date("%A")

	local rank = _G.FCB_MY_RANK
	if rank then
		chip.Text = "FCB " .. tostring(rank)
		chip.Visible = true
	end
end

----------------------------------------------------------------------
-- state + layout target
----------------------------------------------------------------------
local springW = newSpring(30, 12, 0.72)
local springH = newSpring(R + 4, 11, 0.72)
local springC = newSpring(2, 14, 1)

local cards = {}
local menuOpen = false
local hover, pressed = false, false
local lastExpanded = nil
local idleToken = 0

local function setIdleVisible(v)
	idleToken = idleToken + 1
	local my = idleToken
	if v then
		task.delay(0.22, function()
			if my == idleToken then
				tween(idle, 0.3, { GroupTransparency = 0 })
			end
		end)
	else
		tween(idle, 0.15, { GroupTransparency = 1 })
	end
end

local function recalc()
	local expanded = menuOpen or #cards > 0
	local w, h, cr
	if expanded then
		h = PAD_TOP
		if menuOpen then
			h = h + MENU_H + GAP
		end
		for _, c in ipairs(cards) do
			h = h + c.h
		end
		h = h + 6
		w, cr = OPEN_W, 28
	else
		w, h, cr = IDLE_W, IDLE_H, IDLE_H / 2
		if pressed then
			w, h = w - 6, h - 2
		elseif hover then
			w, h = w + 10, h + 2
		end
	end
	aim(springW, w, 0.72, 0.9)
	aim(springH, R + h, 0.7, 0.88)
	springC.t = cr

	if lastExpanded ~= expanded then
		lastExpanded = expanded
		setIdleVisible(not expanded)
	end
end

----------------------------------------------------------------------
-- menu open / close
----------------------------------------------------------------------
local function setMenu(open)
	if menuOpen == open then
		return
	end
	menuOpen = open
	if open then
		updateStats()
		tween(menuWrap, 0.55, { Size = UDim2.new(1, 0, 0, MENU_H + GAP) })
		task.delay(0.1, function()
			if menuOpen then
				tween(menu, 0.4, { GroupTransparency = 0 })
			end
		end)
	else
		tween(menu, 0.2, { GroupTransparency = 1 })
		tween(menuWrap, 0.5, { Size = UDim2.new(1, 0, 0, 0) }, Enum.EasingStyle.Quint, Enum.EasingDirection.InOut)
	end
	recalc()
end

hit.MouseButton1Click:Connect(function()
	setMenu(not menuOpen)
end)
hit.MouseEnter:Connect(function()
	hover = true
	recalc()
end)
hit.MouseLeave:Connect(function()
	hover, pressed = false, false
	recalc()
end)
hit.MouseButton1Down:Connect(function()
	pressed = true
	recalc()
end)
hit.MouseButton1Up:Connect(function()
	pressed = false
	recalc()
end)

function Notification:OpenMenu()
	setMenu(true)
end
function Notification:CloseMenu()
	setMenu(false)
end
function Notification:ToggleMenu()
	setMenu(not menuOpen)
end

----------------------------------------------------------------------
-- notification cards
----------------------------------------------------------------------
local cardOrder = 0

local function dismiss(rec)
	if rec.gone then
		return
	end
	rec.gone = true
	for i, c in ipairs(cards) do
		if c == rec then
			table.remove(cards, i)
			break
		end
	end
	recalc()
	tween(rec.card, 0.25, { GroupTransparency = 1 })
	tween(rec.wrap, 0.45, { Size = UDim2.new(1, 0, 0, 0) }, Enum.EasingStyle.Quint, Enum.EasingDirection.InOut)
	task.delay(0.55, function()
		rec.wrap:Destroy()
	end)
end

local function addCard(notifData, opts, extra)
	local typ = string.lower(tostring(opts.Type or "default"))
	local duration = tonumber(opts.Time) or 5
	local outlineColor = opts.OutlineColor or CFG.Accent
	local title = tostring(notifData.Title or "")
	local desc = tostring(notifData.Description or "")

	local hasIcon = typ == "image"
	local isOption = typ == "option"

	local titleX = hasIcon and 40 or 12
	local titleW = INNER_W - titleX - 12
	local descW = INNER_W - 24

	local titleH = math.max(20, measure(title, 14, titleW).Y + 4)
	local descH = (desc ~= "") and math.max(15, measure(desc, 13, descW).Y) or 0
	local outlineY = 8 + titleH + 2
	local cursor
	local descY = outlineY + 2 + 8
	if descH > 0 then
		cursor = descY + descH
	else
		cursor = outlineY + 2
	end
	local btnY
	if isOption then
		btnY = cursor + 8
		cursor = btnY + 24
	end
	local cardH = cursor + 12

	cardOrder = cardOrder + 1

	local wrap = new("Frame", {
		Name = "CardWrap",
		BackgroundTransparency = 1,
		ClipsDescendants = true,
		LayoutOrder = cardOrder,
		Size = UDim2.new(1, 0, 0, 0),
	}, body)
	local card = new("CanvasGroup", {
		Name = "Card",
		BackgroundColor3 = Color3.fromRGB(17, 17, 20),
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, cardH),
		GroupTransparency = 1,
	}, wrap)
	new("UICorner", { CornerRadius = UDim.new(0, 18) }, card)

	local rec = { wrap = wrap, card = card, h = cardH + GAP, gone = false }

	if not isOption then
		local tap = new("TextButton", {
			BackgroundTransparency = 1,
			Text = "",
			AutoButtonColor = false,
			Size = UDim2.fromScale(1, 1),
			ZIndex = 1,
		}, card)
		tap.MouseButton1Click:Connect(function()
			dismiss(rec)
		end)
	end

	if hasIcon then
		new("ImageLabel", {
			BackgroundTransparency = 1,
			Position = UDim2.fromOffset(12, 8 + math.floor((titleH - 20) / 2)),
			Size = UDim2.fromOffset(20, 20),
			ZIndex = 2,
			Image = extra.Image or "",
			ImageColor3 = extra.ImageColor or Color3.fromRGB(255, 255, 255),
		}, card)
	end

	new("TextLabel", {
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(titleX, 8),
		Size = UDim2.fromOffset(titleW, titleH),
		ZIndex = 2,
		Font = FONT,
		Text = title,
		TextColor3 = Color3.fromRGB(235, 235, 235),
		TextSize = 14,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Center,
	}, card)

	local track = new("Frame", {
		BackgroundColor3 = Color3.fromRGB(38, 38, 44),
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(12, outlineY),
		Size = UDim2.fromOffset(INNER_W - 24, 2),
		ZIndex = 2,
	}, card)
	new("UICorner", { CornerRadius = UDim.new(1, 0) }, track)
	local bar = new("Frame", {
		BackgroundColor3 = outlineColor,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(12, outlineY),
		Size = UDim2.fromOffset(INNER_W - 24, 2),
		ZIndex = 3,
	}, card)
	new("UICorner", { CornerRadius = UDim.new(1, 0) }, bar)

	if descH > 0 then
		new("TextLabel", {
			BackgroundTransparency = 1,
			Position = UDim2.fromOffset(12, descY),
			Size = UDim2.fromOffset(descW, descH),
			ZIndex = 2,
			Font = FONT,
			Text = desc,
			TextColor3 = Color3.fromRGB(165, 165, 175),
			TextSize = 13,
			TextWrapped = true,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextYAlignment = Enum.TextYAlignment.Top,
		}, card)
	end

	if isOption then
		local uncheck = new("ImageButton", {
			Name = "Uncheck",
			BackgroundTransparency = 1,
			Position = UDim2.fromOffset(10, btnY),
			Size = UDim2.fromOffset(24, 24),
			ZIndex = 4,
			AutoButtonColor = false,
			Image = "http://www.roblox.com/asset/?id=6031094678",
			ImageColor3 = Color3.fromRGB(255, 84, 84),
		}, card)
		local check = new("ImageButton", {
			Name = "Check",
			BackgroundTransparency = 1,
			Position = UDim2.fromOffset(38, btnY),
			Size = UDim2.fromOffset(24, 24),
			ZIndex = 4,
			AutoButtonColor = false,
			Image = "http://www.roblox.com/asset/?id=6031094667",
			ImageColor3 = Color3.fromRGB(83, 230, 50),
		}, card)
		uncheck.MouseButton1Click:Connect(function()
			if rec.gone then
				return
			end
			pcall(function()
				if extra.Callback then
					extra.Callback(false)
				end
			end)
			dismiss(rec)
		end)
		check.MouseButton1Click:Connect(function()
			if rec.gone then
				return
			end
			pcall(function()
				if extra.Callback then
					extra.Callback(true)
				end
			end)
			dismiss(rec)
		end)
	end

	table.insert(cards, rec)
	while #cards > MAX_CARDS do
		dismiss(cards[1])
	end
	recalc()

	-- enter animation
	tween(wrap, 0.5, { Size = UDim2.new(1, 0, 0, cardH + GAP) })
	task.delay(0.08, function()
		if not rec.gone then
			tween(card, 0.4, { GroupTransparency = 0 })
		end
	end)

	-- timer bar + auto dismiss
	tween(bar, duration, { Size = UDim2.fromOffset(0, 2) }, Enum.EasingStyle.Linear, Enum.EasingDirection.Out)
	task.delay(duration, function()
		dismiss(rec)
	end)
end

function Notification:Notify(notifData, middledebug, all)
	local ok, err = pcall(addCard, notifData or {}, middledebug or {}, all or {})
	if not ok then
		warn("[Notch] " .. tostring(err))
	end
end

----------------------------------------------------------------------
-- render loop (springs + fps)
----------------------------------------------------------------------
local conn = RunService.RenderStepped:Connect(function(dt)
	fpsFrames = fpsFrames + 1
	fpsTime = fpsTime + dt
	if fpsTime >= 0.5 then
		fps = fpsFrames / fpsTime
		fpsFrames, fpsTime = 0, 0
	end

	dt = math.min(dt, 1 / 20)
	stepSpring(springW, dt)
	stepSpring(springH, dt)
	stepSpring(springC, dt)

	pill.Size = UDim2.fromOffset(math.max(20, springW.x), math.max(R + 8, springH.x))
	pillCorner.CornerRadius = UDim.new(0, math.max(0, springC.x))
end)

----------------------------------------------------------------------
-- slow tick (clock, stats, idle text)
----------------------------------------------------------------------
local idleSwap = 0
local function updateTick()
	updateStats()
	local list = {
		os.date("%H:%M"),
		os.date("%a, %b %d"),
		#Players:GetPlayers() .. " online",
		math.floor(fps + 0.5) .. " fps",
	}
	local cycle = CFG.IdleStyle == "cycle"
	local want = cycle and list[(math.floor(os.clock() / 3) % #list) + 1] or list[1]
	if idleLabel.Text ~= want then
		if cycle then
			idleSwap = idleSwap + 1
			local my = idleSwap
			task.spawn(function()
				tween(idleLabel, 0.15, { TextTransparency = 1 })
				task.wait(0.15)
				if my ~= idleSwap then
					return
				end
				idleLabel.Text = want
				tween(idleLabel, 0.25, { TextTransparency = 0 })
			end)
		else
			idleLabel.Text = want
		end
	end
end

task.spawn(function()
	while gui.Parent do
		pcall(updateTick)
		task.wait(0.5)
	end
end)

env.__FCB_NOTCH_DESTROY = function()
	pcall(function()
		conn:Disconnect()
	end)
	if scaleConn then
		pcall(function()
			scaleConn:Disconnect()
		end)
	end
	pcall(function()
		gui:Destroy()
	end)
end

