local open = false
local currentThread = nil

local function hardReset()
	for _, p in ipairs(buttons) do
		p.h.Position = UDim2.new(0, 0, 0, -100)
		p.h.Size = UDim2.fromOffset(44, 44)
		p.bg.BackgroundTransparency = 1
		p.str.Transparency = 1
		p.icon.ImageTransparency = 1
	end
	menu.Size = UDim2.fromOffset(280, 0)
	menu.Visible = false
	timeLabel.Visible = false
	toggle.Rotation = 0
	toggle.Position = UDim2.new(0.5, -12, 0, 8)
end

local function hardOpen()
	for _, p in ipairs(buttons) do
		p.h.Position = UDim2.new(0, 0, 0, 0)
		p.h.Size = UDim2.fromOffset(44, 44)
		p.bg.BackgroundTransparency = 0
		p.str.Transparency = 0
		p.icon.ImageTransparency = 0
	end
	menu.Size = UDim2.fromOffset(280, 60)
	menu.Visible = true
	timeLabel.Visible = true
	toggle.Rotation = 180
	toggle.Position = UDim2.new(0.5, -12, 0, 72)
end

local function animateIn()
	if currentThread then task.cancel(currentThread) end
	hardReset()
	menu.Visible = true
	timeLabel.Visible = true

	currentThread = task.spawn(function()
		TweenService:Create(toggle, TweenInfo.new(0.6, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
			Rotation = 180,
			Position = UDim2.new(0.5, -12, 0, 72)
		}):Play()

		TweenService:Create(menu, TweenInfo.new(0.6, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
			Size = UDim2.fromOffset(280, 60)
		}):Play()

		for _, p in ipairs(buttons) do
			task.wait(0.07)
			TweenService:Create(p.h, TweenInfo.new(0.75, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Position = UDim2.new(0, 0, 0, 0)}):Play()
			TweenService:Create(p.bg, TweenInfo.new(0.6, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {BackgroundTransparency = 0}):Play()
			TweenService:Create(p.str, TweenInfo.new(0.6, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {Transparency = 0}):Play()
			TweenService:Create(p.icon, TweenInfo.new(0.6, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {ImageTransparency = 0}):Play()
		end
	end)
end

local function animateOut()
	if currentThread then task.cancel(currentThread) end
	hardOpen()

	currentThread = task.spawn(function()
		for i = #buttons, 1, -1 do
			local p = buttons[i]
			task.delay((#buttons - i) * 0.06, function()
				TweenService:Create(p.h, TweenInfo.new(0.45, Enum.EasingStyle.Quint, Enum.EasingDirection.In), {Position = UDim2.new(0, 0, 0, -100)}):Play()
				TweenService:Create(p.bg, TweenInfo.new(0.45, Enum.EasingStyle.Quint), {BackgroundTransparency = 1}):Play()
				TweenService:Create(p.str, TweenInfo.new(0.45, Enum.EasingStyle.Quint), {Transparency = 1}):Play()
				TweenService:Create(p.icon, TweenInfo.new(0.3, Enum.EasingStyle.Quint), {ImageTransparency = 1}):Play()
			end)
		end

		task.wait(0.18)

		TweenService:Create(toggle, TweenInfo.new(0.55, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
			Rotation = 0,
			Position = UDim2.new(0.5, -12, 0, 8)
		}):Play()

		local t = TweenService:Create(menu, TweenInfo.new(0.55, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
			Size = UDim2.fromOffset(280, 0)
		})
		t:Play()
		t.Completed:Wait()
		menu.Visible = false
		timeLabel.Visible = false
	end)
end

toggle.MouseButton1Click:Connect(function()
	open = not open
	if open then animateIn() else animateOut() end
end)

local prefix = "?"

local function onChat(msg)
	if msg:sub(1, #prefix) ~= prefix then return end
	local cmd = msg:sub(#prefix + 1)
	local parts = {}
	for part in cmd:gmatch("%S+") do table.insert(parts, part) end
	if #parts == 0 then return end
	local cmdName = parts[1]:lower()
	for _, c in ipairs(registeredCmds) do
		for _, alias in ipairs(c.alias) do
			if alias:lower() == cmdName then
				if c.args then
					local args = {}
					for i = 2, #parts do table.insert(args, parts[i]) end
					task.spawn(c.callback, table.unpack(args))
				else
					task.spawn(c.callback)
				end
				return
			end
		end
	end
end

