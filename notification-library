----------------------------------------------------------------------
-- live data
----------------------------------------------------------------------
local GREEN = Color3.fromRGB(110, 230, 140)
local YELLOW = Color3.fromRGB(255, 200, 90)
local RED = Color3.fromRGB(255, 100, 100)

local fps = 60
local fpsFrames, fpsTime = 0, 0

local function getPing()
	local ok, v = pcall(function()
		return Stats.Network.ServerStatsItem["Data Ping"]:GetValue()
	end)
	if ok and type(v) == "number" then
		return math.floor(v + 0.5)
	end
	return nil
end

local function updateStats()
	vPlayers.Text = #Players:GetPlayers() .. "/" .. Players.MaxPlayers
	vFps.Text = tostring(math.floor(fps + 0.5))
	vFps.TextColor3 = (fps >= 50 and GREEN) or (fps >= 30 and YELLOW) or RED
	local ping = getPing()
	if ping then
		vPing.Text = ping .. " ms"
		vPing.TextColor3 = (ping < 80 and GREEN) or (ping < 150 and YELLOW) or RED
	else
		vPing.Text = "-"
	end
	vTime.Text = os.date("%H:%M:%S")
	vDate.Text = os.date("%d %b %y")
	vDay.Text = os.date("%A")

	local rank = _G.FCB_MY_RANK
	if rank then
		chip.Text = "FCB " .. tostring(rank)
		chip.Visible = true
	end
end

----------------------------------------------------------------------
-- state + layout target
----------------------------------------------------------------------
local springW = newSpring(30, 12, 0.72)
local springH = newSpring(R + 4, 11, 0.72)
local springC = newSpring(2, 14, 1)

local cards = {}
local menuOpen = false
local hover, pressed = false, false

local function recalc()
	local expanded = menuOpen or #cards > 0
	local w, h, cr
	if expanded then
		h = PAD_TOP
		if menuOpen then
			h = h + MENU_H + GAP
		end
		for _, c in ipairs(cards) do
			h = h + c.h
		end
		h = h + 20 -- bottom breathing room (was 6; bottom tile row was getting clipped)
		w, cr = OPEN_W, 26
	else
		w, h, cr = IDLE_W, IDLE_H, IDLE_H / 2
		if pressed then
			w, h = w - 6, h - 2
		elseif hover then
			w, h = w + 10, h + 2
		end
	end
	aim(springW, w, 0.72, 0.9)
	aim(springH, R + h, 0.7, 0.88)
	springC.t = cr
end

----------------------------------------------------------------------
-- menu open / close
----------------------------------------------------------------------
local function setMenu(open)
	if menuOpen == open then
		return
	end
	menuOpen = open
	if open then
		updateStats()
		tween(menuWrap, 0.55, { Size = UDim2.new(1, 0, 0, MENU_H + GAP) })
		task.delay(0.12, function()
			if menuOpen then
				tween(menu, 0.4, { GroupTransparency = 0 })
			end
		end)
	else
		tween(menu, 0.2, { GroupTransparency = 1 })
		tween(menuWrap, 0.5, { Size = UDim2.new(1, 0, 0, 0) }, Enum.EasingStyle.Quint, Enum.EasingDirection.InOut)
	end
	recalc()
end

hit.MouseButton1Click:Connect(function()
	setMenu(not menuOpen)
end)
hit.MouseEnter:Connect(function()
	hover = true
	recalc()
end)
hit.MouseLeave:Connect(function()
	hover, pressed = false, false
	recalc()
end)
hit.MouseButton1Down:Connect(function()
	pressed = true
	recalc()
end)
hit.MouseButton1Up:Connect(function()
	pressed = false
	recalc()
end)

function Notification:OpenMenu()
	setMenu(true)
end
function Notification:CloseMenu()
	setMenu(false)
end
function Notification:ToggleMenu()
	setMenu(not menuOpen)
end

----------------------------------------------------------------------
-- notification cards
----------------------------------------------------------------------
local cardOrder = 0

local function dismiss(rec)
	if rec.gone then
		return
	end
	rec.gone = true
	for i, c in ipairs(cards) do
		if c == rec then
			table.remove(cards, i)
			break
		end
	end
	recalc()
	tween(rec.card, 0.25, { GroupTransparency = 1 })
	tween(rec.wrap, 0.45, { Size = UDim2.new(1, 0, 0, 0) }, Enum.EasingStyle.Quint, Enum.EasingDirection.InOut)
	task.delay(0.55, function()
		rec.wrap:Destroy()
	end)
end

local function addCard(notifData, opts, extra)
	local typ = string.lower(tostring(opts.Type or "default"))
	local duration = tonumber(opts.Time) or 5
	local outlineColor = opts.OutlineColor or CFG.Accent
	local title = tostring(notifData.Title or "")
	local desc = tostring(notifData.Description or "")

	local hasIcon = typ == "image"
	local isOption = typ == "option"

	local titleX = hasIcon and 38 or 12
	local titleW = INNER_W - titleX - 12
	local descW = INNER_W - 24

	local titleH = math.max(18, measure(title, 13, titleW, FONT_BOLD).Y + 4)
	local descH = (desc ~= "") and math.max(14, measure(desc, 12, descW, FONT).Y) or 0
	local outlineY = 8 + titleH + 2
	local descY = outlineY + 2 + 6
	local cursor
	if descH > 0 then
		cursor = descY + descH
	else
		cursor = outlineY + 2
	end
	local btnY
	if isOption then
		btnY = cursor + 8
		cursor = btnY + 22
	end
	local cardH = cursor + 10

	cardOrder = cardOrder + 1

	local wrap = new("Frame", {
		Name = "CardWrap",
		BackgroundTransparency = 1,
		ClipsDescendants = true,
		LayoutOrder = cardOrder,
		Size = UDim2.new(1, 0, 0, 0),
	}, body)
	local card = new("CanvasGroup", {
		Name = "Card",
		BackgroundColor3 = Color3.fromRGB(255, 255, 255),
		BorderSizePixel = 0,
		Size = UDim2.fromOffset(INNER_W, cardH),
		GroupTransparency = 1,
	}, wrap)
	new("UICorner", { CornerRadius = UDim.new(0, 16) }, card)
	new("UIGradient", vGradient(Color3.fromRGB(27, 27, 32), Color3.fromRGB(16, 16, 19)), card)
	new("UIStroke", { Color = Color3.fromRGB(38, 38, 44), Thickness = 1 }, card)

	local rec = { wrap = wrap, card = card, h = cardH + GAP, gone = false }

	if not isOption then
		local tap = new("TextButton", {
			BackgroundTransparency = 1,
			Text = "",
			AutoButtonColor = false,
			Size = UDim2.fromScale(1, 1),
			ZIndex = 1,
		}, card)
		tap.MouseButton1Click:Connect(function()
			dismiss(rec)
		end)
	end

	if hasIcon then
		new("ImageLabel", {
			BackgroundTransparency = 1,
			Position = UDim2.fromOffset(12, 8 + math.floor((titleH - 18) / 2)),
			Size = UDim2.fromOffset(18, 18),
			ZIndex = 2,
			Image = extra.Image or "",
			ImageColor3 = extra.ImageColor or Color3.fromRGB(255, 255, 255),
		}, card)
	end

	new("TextLabel", {
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(titleX, 8),
		Size = UDim2.fromOffset(titleW, titleH),
		ZIndex = 2,
		Font = FONT_BOLD,
		Text = title,
		TextColor3 = Color3.fromRGB(240, 240, 240),
		TextSize = 13,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Center,
	}, card)

	local track = new("Frame", {
		BackgroundColor3 = Color3.fromRGB(40, 40, 46),
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(12, outlineY),
		Size = UDim2.fromOffset(INNER_W - 24, 2),
		ZIndex = 2,
	}, card)
	new("UICorner", { CornerRadius = UDim.new(1, 0) }, track)
	local bar = new("Frame", {
		BackgroundColor3 = outlineColor,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(12, outlineY),
		Size = UDim2.fromOffset(INNER_W - 24, 2),
		ZIndex = 3,
	}, card)
	new("UICorner", { CornerRadius = UDim.new(1, 0) }, bar)

	if descH > 0 then
		new("TextLabel", {
			BackgroundTransparency = 1,
			Position = UDim2.fromOffset(12, descY),
			Size = UDim2.fromOffset(descW, descH),
			ZIndex = 2,
			Font = FONT,
			Text = desc,
			TextColor3 = Color3.fromRGB(160, 160, 172),
			TextSize = 12,
			TextWrapped = true,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextYAlignment = Enum.TextYAlignment.Top,
		}, card)
	end

	if isOption then
		local uncheck = new("ImageButton", {
			Name = "Uncheck",
			BackgroundTransparency = 1,
			Position = UDim2.fromOffset(10, btnY),
			Size = UDim2.fromOffset(22, 22),
			ZIndex = 4,
			AutoButtonColor = false,
			Image = "http://www.roblox.com/asset/?id=6031094678",
			ImageColor3 = Color3.fromRGB(255, 84, 84),
		}, card)
		local check = new("ImageButton", {
			Name = "Check",
			BackgroundTransparency = 1,
			Position = UDim2.fromOffset(36, btnY),
			Size = UDim2.fromOffset(22, 22),
			ZIndex = 4,
			AutoButtonColor = false,
			Image = "http://www.roblox.com/asset/?id=6031094667",
			ImageColor3 = Color3.fromRGB(83, 230, 50),
		}, card)
		uncheck.MouseButton1Click:Connect(function()
			if rec.gone then
				return
			end
			pcall(function()
				if extra.Callback then
					extra.Callback(false)
				end
			end)
			dismiss(rec)
		end)
		check.MouseButton1Click:Connect(function()
			if rec.gone then
				return
			end
			pcall(function()
				if extra.Callback then
					extra.Callback(true)
				end
			end)
			dismiss(rec)
		end)
	end

	table.insert(cards, rec)
	while #cards > MAX_CARDS do
		dismiss(cards[1])
	end
	recalc()

	-- enter animation
	tween(wrap, 0.5, { Size = UDim2.new(1, 0, 0, cardH + GAP) })
	task.delay(0.1, function()
		if not rec.gone then
			tween(card, 0.4, { GroupTransparency = 0 })
		end
	end)

	-- timer bar + auto dismiss
	tween(bar, duration, { Size = UDim2.fromOffset(0, 2) }, Enum.EasingStyle.Linear, Enum.EasingDirection.Out)
	task.delay(duration, function()
		dismiss(rec)
	end)
end

function Notification:Notify(notifData, middledebug, all)
	local ok, err = pcall(addCard, notifData or {}, middledebug or {}, all or {})
	if not ok then
		warn("[Notch] " .. tostring(err))
	end
end

----------------------------------------------------------------------
-- render loop (springs + fps)
----------------------------------------------------------------------
local conn = RunService.RenderStepped:Connect(function(dt)
	fpsFrames = fpsFrames + 1
	fpsTime = fpsTime + dt
	if fpsTime >= 0.5 then
		fps = fpsFrames / fpsTime
		fpsFrames, fpsTime = 0, 0
	end

	dt = math.min(dt, 1 / 20)
	stepSpring(springW, dt)
	stepSpring(springH, dt)
	stepSpring(springC, dt)

	pill.Size = UDim2.fromOffset(math.max(20, springW.x), math.max(R + 8, springH.x))
	pillCorner.CornerRadius = UDim.new(0, math.max(0, springC.x))
end)

-- stats refresh (only while the menu is open)
task.spawn(function()
	while gui.Parent do
		if menuOpen then
			pcall(updateStats)
		end
		task.wait(0.5)
	end
end)

env.__FCB_NOTCH_DESTROY = function()
	pcall(function()
		conn:Disconnect()
	end)
	if scaleConn then
		pcall(function()
			scaleConn:Disconnect()
		end)
	end
	pcall(function()
		gui:Destroy()
	end)
end

-- intro: the pill pops out of the top edge
recalc()

return Notification
