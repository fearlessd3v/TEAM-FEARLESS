local function HttpGet(url)
	if request then
		return request({Url = url, Method = "GET"}).Body
	elseif http_request then
		return http_request({Url = url, Method = "GET"}).Body
	elseif syn and syn.request then
		return syn.request({Url = url, Method = "GET"}).Body
	else
		return game:HttpGet(url)
	end
end

local function getClientId()
	local cid
	pcall(function()
		cid = tostring(game:GetService("RbxAnalyticsService"):GetClientId())
		cid = cid:gsub("%-",""):lower()
	end)
	return cid or ""
end

local function FetchPremiumUsers()
	local success = pcall(function()
		local HttpService = game:GetService("HttpService")
		local url = "https://raw.githubusercontent.com/fearlessd3v/TEAM-FEARLESS/refs/heads/main/premium-users"
		local response = HttpGet(url)
		local data = HttpService:JSONDecode(response)

		for i, entry in pairs(data) do
			local id = tostring(entry.id or entry):lower():gsub("%-","")
			local exp = tonumber(entry.expires)
			if id ~= "" then
				PremiumData[id] = {
					expires = exp or math.huge,
					position = i
				}
			end
		end

		premiumCheckComplete = true
	end)

	if not success then
		premiumCheckComplete = true
	end
end

local function CalculateMyRank()
	while not premiumCheckComplete do
		task.wait(0.1)
	end

	local cid = getClientId()
	if not cid or cid == "" then return "USER" end

	local data = PremiumData[cid]
	if not data then return "USER" end
	if os.time() > data.expires then return "USER" end

	if data.position == 1 then
		return "OWNER"
	else
		return "PREMIUM"
	end
end

