--[[
	FEARLESS NOTCH
	Dynamic-island style pill at the top center of the screen.
	  * Idle:   small black pill (time + soft pulsing dot)
	  * Click:  springs open into the info menu (avatar, name, players, FPS, ping, date, day, time)
	  * Notify: notifications drop out of the notch and stack under each other

	Usage (same API as before):
		local Notification = loadstring(game:HttpGet("YOUR_RAW_LINK"))()
		Notification:Notify(
			{ Title = "Hello", Description = "text" },
			{ Type = "default", Time = 5, OutlineColor = Color3.fromRGB(0, 170, 255) }
		)
	Types: "default" | "image" (3rd table: Image, ImageColor) | "option" (3rd table: Callback(bool))

	Extra:
		Notification:ToggleMenu() / :OpenMenu() / :CloseMenu()
		Notification.Config.IdleStyle = "time" | "cycle"   -- "cycle" rotates time / date / players / fps
]]

