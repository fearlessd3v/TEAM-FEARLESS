-- stat tiles (fixed positions, no layout object => no reflow)
local function makeTile(caption, col, row)
	local tile = new("Frame", {
		BackgroundColor3 = Color3.fromRGB(255, 255, 255),
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(col * (TILE_W + TILE_GAP), GRID_Y + row * (TILE_H + TILE_GAP)),
		Size = UDim2.fromOffset(TILE_W, TILE_H),
	}, menu)
	new("UICorner", { CornerRadius = UDim.new(0, 11) }, tile)
	new("UIStroke", { Color = Color3.fromRGB(38, 38, 44), Thickness = 1 }, tile)
	new("UIGradient", vGradient(Color3.fromRGB(27, 27, 32), Color3.fromRGB(16, 16, 19)), tile)
	new("TextLabel", {
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(9, 5),
		Size = UDim2.fromOffset(TILE_W - 18, 10),
		Font = FONT_BOLD,
		TextSize = 8,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = Color3.fromRGB(105, 105, 118),
		Text = caption,
	}, tile)
	local value = new("TextLabel", {
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(9, 16),
		Size = UDim2.fromOffset(TILE_W - 18, 15),
		Font = FONT_BOLD,
		TextSize = 13,
		TextScaled = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = Color3.fromRGB(238, 238, 238),
		Text = "-",
	}, tile)
	new("UITextSizeConstraint", { MaxTextSize = 13, MinTextSize = 8 }, value)
	return value
end

