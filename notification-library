cmdBox.FocusLost:Connect(function(entered)
	if entered then
		local text = cmdBox.Text:match("^%s*(.-)%s*$")
		local parts = {}
		for p in text:gmatch("%S+") do table.insert(parts, p) end
		if #parts > 0 then
			local exactMatch = false
			for _, cmd in ipairs(registeredCmds) do
				for _, alias in ipairs(cmd.alias) do
					if alias:lower() == parts[1]:lower() then
						exactMatch = true
						break
					end
				end
				if exactMatch then break end
			end
			if exactMatch then
				parseAndRun(text)
			else
				parseAndRunBestMatch(text)
			end
		end
	end
	closeCmd()
end)

